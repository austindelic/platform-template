{
  "name": "platform-starter",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts",
    "infra/*",
    "tests"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "check": "vp run -r check",
    "test": "vp test run",
    "build": "bun run --cwd apps/web build && bun run --cwd apps/docs build && bun run --cwd apps/worker build",
    "format": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate",
    "infra:up": "docker compose -f infra/local/compose.yml up -d --wait && bun --no-env-file scripts/local-storage.ts",
    "infra:down": "docker compose -f infra/local/compose.yml down",
    "infra:check": "sh infra/cloud/check.sh"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260907.1",
    "@playwright/test": "^1.63.0",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "^4.1.10",
    "wrangler": "4.129.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24.21.0"
  },
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.8",
    "vite-plus": "0.2.8"
  }
}
