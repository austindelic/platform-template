# Copy to terraform.tfvars (ignored by Git). Identifiers only; no secret belongs here.
state_bucket   = "YOUR_STATE_BUCKET"
state_endpoint = "https://YOUR_32_CHARACTER_ACCOUNT_ID.r2.cloudflarestorage.com"

infisical_project_ids = {
  runtime_staging = "00000000-0000-0000-0000-000000000001" # <app>-runtime-staging
  runtime_prod    = "00000000-0000-0000-0000-000000000002" # <app>-runtime-prod
  deploy_staging  = "00000000-0000-0000-0000-000000000003" # <app>-deploy-staging
  deploy_prod     = "00000000-0000-0000-0000-000000000004" # <app>-deploy-prod
  backups_prod    = "00000000-0000-0000-0000-000000000005" # <app>-backups-prod
}
